<!-- API 31+. NFR-010 / D-011: cloud backup and device transfer carry the saves and stats (lantern.db, Room, TRUNCATE
     journal per ADR-014, so the one file is always consistent) and the settings (files/datastore/settings.preferences_pb).
     Only these are included; nothing else the app writes (caches, no-backup files) is copied. BackupRulesTest checks
     this file and backup_rules.xml stay identical. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="lantern.db" />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="lantern.db" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
